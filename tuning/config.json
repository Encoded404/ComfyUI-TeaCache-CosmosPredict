{
    "comfy_dir": "/path/to/ComfyUI",
    "model_name": "anima-base-v1.0.safetensors",
    "clip_name": "qwen_3_06b_base.safetensors",
    "clip_type": "qwen_image",
    "vae_name": "qwen_image_vae.safetensors",

    "sampling": {
        "default_steps": 30,
        "step_variants": [15, 30, 45],
        "step_weights": [0.15, 0.70, 0.15],
        "cfg": 5.0,
        "sampler": "er_sde",
        "scheduler": "normal",
        "width": 512,
        "height": 512,
        "resolution_mix": {"512x512": 0.75, "1024x1024": 0.15, "1024x512": 0.1},
        "sampler_variants": ["er_sde", "dpmpp_2m_sde", "euler_a"],
        "scheduler_variants": ["normal", "simple"],
        "cfg_variants": [4.0, 4.5, 5.0, 5.5]
    },

    "calibration": {
        "prompts_file": "prompts/calibration.json",
        "prompt_selection": "semantic_diversity",
        "prompt_tag_filter": [],
        "num_prompts": 30,
        "seeds": [34635345, 53453634, 267454, 123],
        "negative_prompt": "",
        "record_block_data": true
    },

    "optimization": {
        "sources": ["t_emb", "first_block_shift", "pooled_latent"],
        "step_count_variants": [3, 15, 45, 60],
        "pooled_latent_mode": "mean",
        "metric_types": ["mean_only", "mean_and_max", "mean_max_std"],
        "metric_weights_scenarios": [
            {"mean": 1.0},
            {"mean": 0.7, "max": 0.3},
            {"mean": 0.5, "max": 0.3, "std": 0.2}
        ],
        "mapping_types": ["identity", "polynomial", "power_law", "softplus"],
        "poly_degrees": [3, 4, 5],
        "accumulation_types": ["hard_reset", "carry_over", "leaky", "windowed"],
        "accumulation_params": [
            {},
            {"param": "leak_factor", "start": 0.50, "end": 0.99, "steps": 12, "spacing": "linear"},
            {"param": "leak_factor", "start": 0.991, "end": 0.999, "steps": 3, "spacing": "linear"},
            {"param": "window_size", "start": 2, "end": 15, "steps": 12, "spacing": "linear"}
        ],
        "residual_strategies": ["hard"],
        "step_schedules": ["constant", "cosine", "linear_ramp", "linear_decay", "bell"],
        "signal_scales": {
            "t_emb": [10, 50, 100, 200],
            "first_block_shift": [1.0],
            "pooled_latent": [1.0, 10, 50]
        },
        "auto_scale_target": 1.0,
        "block_modes": ["all_or_nothing", "split_fraction", "split_groups", "dynamic"],
        "block_levels": ["unified", "per_group"],
        "block_level_config_scope": ["accumulation_type", "step_schedule"],
        "cosim_thresholds": [
            {"param": "cosim_threshold", "start": 0.85, "end": 0.99, "steps": 5, "spacing": "linear"}
        ],
        "block_params_scenarios": {
            "split_fraction": [
                {"param": "always_fraction", "start": 0.05, "end": 0.70, "steps": 10, "spacing": "linear"}
            ]
        },
        "candidate_thresholds": [
            {"param": "thresh", "start": 0.001, "end": 0.50, "steps": 20, "spacing": "geom"}
        ],
        "pareto_threshold_range": [0.0001, 10.0],
        "pareto_threshold_count": 1000,
        "quality_scoring": {
            "type": "thresholded_power",
            "target": 0.05,
            "power": 8.0,
            "target_quality": 0.9
        },
        "cross_validate": true,
        "cv_holdout_fraction": 0.2,
        "max_candidates": 0
    },

    "validation": {
        "prompts_file": "prompts/benchmark.json",
        "prompt_selection": "semantic_diversity",
        "prompt_tag_filter": [],
        "num_prompts": 2,
        "seeds": [34635345, 53453634, 267454, 123],
        "num_error_samples": 8,
        "error_samples_span": 1,
        "include_score_top": 2,
        "resolutions": [[512, 512], [1024, 1024], [1024, 512]],
        "step_counts": [20, 30, 40],
        "extra_threshold_sweep": [0.001, 0.002, 0.003, 0.005, 0.007, 0.01, 0.02, 0.04, 0.07, 0.10, 0.20, 0.40, 0.65, 1.0, 5.0],
        "extra_threshold_sweep_errors": [0.01, 0.03, 0.05, 0.10]
    },

    "refiner": {
        "enabled": true,
        "top_n": -1,
        "record_slots": "both",
        "dtype": "bfloat16",
        "keep_all": true,
        "eval_prompts": 6,
        "record_lags": [1, 2, 3, 4, 8, 16],
        "clevel": 9,
        "implicit_d0": true
    },

    "refiner_training": {
        "multipass": true,
        "refine_passes_max": 3,
        "k_curriculum": true,
        "stop_grad": true,
        "lag_cond": true,
        "res_cond": true,
        "lag_loss_normalize": true,
        "deburst_windows": true,
        "deburst_window_runs": 64,
        "model_size": "20m",
        "depth": "auto",
        "loss": "rel_mse",
        "spectral_penalty": 0.01,
        "spectral_mode": "fraction",
        "calibrate_gains": 2048,
        "gain_strength": 0.5,
        "optimizer": "muon",
        "muon_lr": 0.01,
        "muon_adjusted_lr": true,
        "lr": 4e-4,
        "batch_hessian_fraction": 0.5,
        "batch_size": 64,
        "max_steps": 40000,
        "eval_every": 4000,
        "eval_schedule_growth": 1.0,
        "eval_interval_cap": 8000,
        "eval_max_batches": 512,
        "eval_min_batches_per_shape": 40,
        "eval_full_k_every": 5,
        "beacon_enabled": true,
        "beacon_every": 500,
        "beacon_max_batches": 96,
        "beacon_min_batches_per_shape": 8,
        "beacon_lr_control": true,
        "beacon_lr_patience": 3,
        "beacon_lr_factor": 0.5,
        "beacon_lr_floor": 2e-5,
        "beacon_select_best": true,
        "beacon_save_state": true,
        "ema_decay": 0.9999,
        "normalization": "perchannel",
        "normalization_samples": 128,
        "lag_weights": [2.0, 1.5, 1.25, 1.0, 0.5, 0.25],
        "resolution_curriculum": {
            "enabled": false,
            "stage1_fraction": 0.15,
            "stage1_shapes": ["64x64"],
            "stage2_ramp_fraction": 0.15
        },
        "bucket_weights": {"64x64": 1.0, "64x128": 1.25, "128x128": 2.0},
        "shape_loss_weights": {},
        "grad_surgery": "none",
        "accumulate_big_batches": true,
        "scale_aug": true,
        "cache_size": 32,
        "recovery_fit_batches": 128,
        "recovery_eval_batches": 64,
        "num_workers": 4,
        "prefetch_queue": 0,
        "seed": 42
    },

    "output_dir": "outputs",
    "artist_tags": {
        "enabled": true,
        "pool_file": "prompts/artists.json",
        "weight_mode": "relative",
        "max_tags": 1,
        "seed": 42
    }
}
